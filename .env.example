# 密钥仅放在本机环境变量，不写入数据库或浏览器。
VOLCENGINE_API_KEY=
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.openai.com/v1
TRANSLATION_MODEL=gpt-4o-mini
# 可选：自定义本地目录与工具路径。
# REDUB_DATA_DIR=/absolute/path/to/redub-data
# REDUB_PYTHON=/absolute/path/to/python3.11
# REDUB_FFMPEG=/absolute/path/to/ffmpeg
# REDUB_FFPROBE=/absolute/path/to/ffprobe
# 桌面正式更新源（HTTPS）；发布前填写。
# REDUB_UPDATE_URL=https://your-host.example/releases
# 网页热更新：HTTPS 签名包地址、Ed25519 PEM 公钥（可用 Base64 编码）。
# REDUB_WEB_UPDATE_URL=https://your-host.example/releases/web-latest.json
# REDUB_WEB_PUBLIC_KEY=base64-encoded-public-pem
# 仅发布端需要，勿分发私钥：
# REDUB_WEB_PRIVATE_KEY_FILE=/absolute/path/to/private.pem
