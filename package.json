{
  "name": "redub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "nuxt build && node scripts/prepare-runtime.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "desktop": "electron .",
    "desktop:pack": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "desktop:dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "models:install": "bash scripts/install-models.sh",
    "format": "prettier --write app server shared scripts electron tests *.ts *.cjs *.json",
    "format:check": "prettier --check app server shared scripts electron tests *.ts *.cjs *.json",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@types/formidable": "^3.5.1",
    "@types/node": "^22.19.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5",
    "@iconify-json/carbon": "^1.2.18",
    "@libsql/client": "^0.17.0",
    "@nuxt/ui": "^4.11.1",
    "drizzle-orm": "^0.45.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "formidable": "^3.5.4",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.2.0",
    "vue": "^3.5.30",
    "zod": "^4.3.6"
  },
  "description": "保留背景与原声质感的本地 AI 配音工作室",
  "author": "ReDub"
}
