{
  "name": "redub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "desktop": "electron .",
    "desktop:dev": "REDUB_DEV_URL=http://127.0.0.1:3000 electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "models:install": "bash scripts/install-models.sh"
  },
  "dependencies": {
    "@iconify-json/carbon": "^1.2.18",
    "@libsql/client": "^0.17.0",
    "@nuxt/ui": "^4.11.1",
    "drizzle-orm": "^0.45.1",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "formidable": "^3.5.4",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.2.0",
    "vue": "^3.5.30",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/formidable": "^3.5.1",
    "@types/node": "^22.19.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  }
}
